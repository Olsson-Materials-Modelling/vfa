 &GLOBAL
   PROJECT_NAME run
   RUN_TYPE CELL_OPT
 &END GLOBAL
 &MOTION
   &CELL_OPT
     TYPE DIRECT_CELL_OPT
   &END CELL_OPT
   &PRINT
     &CELL
       &EACH
         CELL_OPT 1
       &END EACH
     &END CELL
   &END PRINT
 &END MOTION
 &FORCE_EVAL
   METHOD QS
   &SUBSYS
     &CELL
       A     1.0000000000000000E+01    0.0000000000000000E+00    0.0000000000000000E+00
       B     1.0000000000000000E+00    1.0000000000000000E+01    0.0000000000000000E+00
       C     0.0000000000000000E+00    0.0000000000000000E+00    1.0000000000000000E+01
       PERIODIC  XYZ
       MULTIPLE_UNIT_CELL  1 1 1
       &CELL_REF
         A     1.1000000000000000E+01    0.0000000000000000E+00    0.0000000000000000E+00
         B     0.0000000000000000E+00    1.1000000000000000E+01    0.0000000000000000E+00
         C     0.0000000000000000E+00    0.0000000000000000E+00    1.1000000000000000E+01
         PERIODIC  XYZ
       &END CELL_REF
     &END CELL
     &COORD
A    1.0000000000000000E+00    2.0000000000000000E+00    3.0000000000000000E+00
B    4.0000000000000000E+00    5.0000000000000000E+00    6.0000000000000000E+00 MOL
B    1.2000000000000000E+01    8.0000000000000000E+00    9.0000000000000000E+00
     &END COORD
     &KIND A
       ELEMENT  A
     &END KIND
     &TOPOLOGY
       NUMBER_OF_ATOMS  3
       MULTIPLE_UNIT_CELL  1 1 1
     &END TOPOLOGY
   &END SUBSYS
 &END FORCE_EVAL
